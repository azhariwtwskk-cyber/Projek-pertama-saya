<?php
declare(strict_types=1);

ini_set('display_errors', '1');
ini_set('display_startup_errors', '1');
error_reporting(E_ALL);

$checks = [];
function cpmsDiag(string $name, bool $pass, string $details = ''): void
{
    global $checks;
    $checks[] = [
        'name' => $name,
        'pass' => $pass,
        'details' => $details,
    ];
}

cpmsDiag('PHP Version', version_compare(PHP_VERSION, '7.4.0', '>='),
    PHP_VERSION);

$files = [
    'Database bridge' => __DIR__ . '/db.php',
    'Permission engine' => __DIR__ . '/cpms/includes/permission_engine.php',
    'GPS service' => __DIR__ . '/cpms/includes/gps_attendance_service.php',
    'Shift service' => __DIR__ . '/cpms/includes/attendance_shift_service.php',
    'Mobile Attendance' => __DIR__ . '/mobile_attendance.php',
];
foreach ($files as $label => $path) {
    cpmsDiag($label, is_file($path), $path);
}

$databaseReady = false;
try {
    require_once __DIR__ . '/db.php';
    $databaseReady = isset($conn) && $conn instanceof mysqli;
    cpmsDiag(
        'Database connection',
        $databaseReady,
        $databaseReady ? 'Connected' : 'Pemboleh ubah $conn tidak tersedia'
    );
} catch (Throwable $exception) {
    cpmsDiag('Database connection', false, $exception->getMessage());
}

if ($databaseReady) {
    $tables = [
        'cpms_attendance_sessions',
        'cpms_attendance_shifts',
        'cpms_attendance_shift_assignments',
        'cpms_attendance_rotation_plans',
        'cpms_attendance_rotation_items',
        'cpms_attendance_rotation_assignments',
    ];
    foreach ($tables as $table) {
        try {
            $safe = $conn->real_escape_string($table);
            $result = $conn->query(
                "SELECT COUNT(*) total FROM information_schema.tables
                 WHERE table_schema = DATABASE() AND table_name = '{$safe}'"
            );
            $row = $result ? $result->fetch_assoc() : null;
            cpmsDiag(
                'Table: ' . $table,
                is_array($row) && (int) $row['total'] === 1,
                is_array($row) && (int) $row['total'] === 1
                    ? 'Ready' : 'Missing'
            );
        } catch (Throwable $exception) {
            cpmsDiag('Table: ' . $table, false, $exception->getMessage());
        }
    }

    $columns = [
        'shift_assignment_id',
        'rotation_assignment_id',
        'resolved_shift_id',
        'scheduled_start_at',
        'scheduled_end_at',
        'late_minutes',
        'worked_minutes',
        'overtime_minutes',
    ];
    foreach ($columns as $column) {
        try {
            $safe = $conn->real_escape_string($column);
            $result = $conn->query(
                "SELECT COUNT(*) total FROM information_schema.columns
                 WHERE table_schema = DATABASE()
                   AND table_name = 'cpms_attendance_sessions'
                   AND column_name = '{$safe}'"
            );
            $row = $result ? $result->fetch_assoc() : null;
            cpmsDiag(
                'Column: sessions.' . $column,
                is_array($row) && (int) $row['total'] === 1,
                is_array($row) && (int) $row['total'] === 1
                    ? 'Ready' : 'Missing'
            );
        } catch (Throwable $exception) {
            cpmsDiag(
                'Column: sessions.' . $column,
                false,
                $exception->getMessage()
            );
        }
    }
}

$allPass = true;
foreach ($checks as $check) {
    if (!$check['pass']) {
        $allPass = false;
        break;
    }
}
?>
<!doctype html>
<html lang="ms">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>GPS Attendance Diagnostic | CPMS</title>
<style>
body{font:15px Arial;background:#eef3f9;color:#10213d;margin:0;padding:20px}
main{max-width:920px;margin:auto;background:#fff;padding:24px;border-radius:16px}
h1{margin-top:0}.summary{padding:14px;border-radius:10px;font-weight:bold}
.pass{background:#dcfce7;color:#166534}.fail{background:#fee2e2;color:#991b1b}
table{width:100%;border-collapse:collapse;margin-top:18px}
th,td{padding:11px;border-bottom:1px solid #e2e8f0;text-align:left}
.yes{color:#07852f;font-weight:bold}.no{color:#b42318;font-weight:bold}
code{word-break:break-all}
</style>
</head>
<body><main>
<h1>GPS Attendance Diagnostic</h1>
<p class="summary <?= $allPass ? 'pass' : 'fail' ?>">
<?= $allPass ? 'PASS — semua komponen tersedia.'
    : 'FAIL — lihat baris merah di bawah.' ?>
</p>
<table>
<tr><th>Pemeriksaan</th><th>Status</th><th>Maklumat</th></tr>
<?php foreach ($checks as $check): ?>
<tr>
<td><?= htmlspecialchars($check['name'], ENT_QUOTES, 'UTF-8') ?></td>
<td class="<?= $check['pass'] ? 'yes' : 'no' ?>">
<?= $check['pass'] ? 'PASS' : 'FAIL' ?></td>
<td><code><?= htmlspecialchars(
    $check['details'], ENT_QUOTES, 'UTF-8'
) ?></code></td>
</tr>
<?php endforeach; ?>
</table>
<p>Selepas selesai, padam atau rename fail diagnosis ini.</p>
</main></body>
</html>
